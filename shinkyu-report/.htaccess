# Xサーバー（Apache）用の設定

# 常に https で開く
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

DirectoryIndex index.html

# 設定ファイルの見本・説明書・テスト用ファイルは公開しない
<FilesMatch "^(config\.sample\.php|README\.md)$">
  Require all denied
</FilesMatch>

# 画面を更新したらすぐ反映されるように
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
