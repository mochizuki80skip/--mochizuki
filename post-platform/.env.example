# --- DB (PostgreSQL) ---
DATABASE_URL=

# --- 管理画面ログイン（本部） ---
NEXTAUTH_SECRET=            # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3002
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# --- トークン暗号化キー（Google / Instagram のトークンを DB に保存する際に使用） ---
ENCRYPTION_KEY=             # openssl rand -base64 32

# --- Google（GBP API）OAuth クライアント ---
# Google Cloud Console > API とサービス > 認証情報 > OAuth クライアント ID（ウェブアプリケーション）
# 承認済みのリダイレクト URI: {NEXTAUTH_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- 投稿文の AI 生成（Gemini） ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Instagram Graph API のバージョン ---
IG_GRAPH_VERSION=v23.0

# --- 外部 Cron から /api/cron/dispatch を叩く際の認証 ---
CRON_SECRET=
