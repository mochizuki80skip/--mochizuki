# ===== XServer VPS（docker compose）で使う値 =====
DOMAIN=post.example.com        # このシステムのドメイン（DNS の A レコードを VPS の IP に向ける）
DB_PASSWORD=                   # PostgreSQL のパスワード（openssl rand -hex 16）

# ===== 管理画面ログイン（本部） =====
NEXTAUTH_SECRET=               # openssl rand -base64 32
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# ===== トークン・パスワードの暗号化キー =====
# openssl rand -base64 32 。後から変えると保存済みのトークン・ログイン情報が読めなくなるので必ず控えておく
ENCRYPTION_KEY=

# ===== Google（GBP API）OAuth クライアント =====
# 承認済みのリダイレクト URI: https://{DOMAIN}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== AI（Gemini）：文章・背景画像・分析 =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ===== Instagram Graph API のバージョン =====
IG_GRAPH_VERSION=v23.0

# ===== Cron の認証 =====
CRON_SECRET=                   # openssl rand -hex 16

# ===== ローカル開発時のみ（docker compose では自動設定） =====
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/post_platform
# NEXTAUTH_URL=http://localhost:3002
# PUBLIC_BASE_URL=http://localhost:3002
# MEDIA_DIR=./storage/media
