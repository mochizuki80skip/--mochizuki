// 接骨院 GBP / Instagram 一括投稿プラットフォーム

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 本部の管理画面ログインユーザー
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

// Google アカウント連携（1 件のみ。GBP の管理者権限を持つアカウント）
model GoogleConnection {
  id           String   @id @default("default")
  email        String?
  refreshToken String   // 暗号化して保存
  connectedAt  DateTime @default(now())
}

// 全体設定（1 件のみ）
model Settings {
  id             String @id @default("default")
  postingDays    Int[]  @default([1, 3, 5, 6]) // 0=日 … 6=土
  postingTime    String @default("10:00")      // JST
  themeCursor    Int    @default(0)            // テーマのローテーション位置
  commonHashtags String @default("#接骨院 #整骨院 #骨盤矯正 #肩こり #腰痛")
  extraNgWords   String @default("")           // 1 行に 1 つ
  brandColor     String @default("#1a73e8")    // 画像・動画の帯の色
}

// 投稿対象の店舗（接骨院のみを登録する）
model Store {
  id               String    @id @default(cuid())
  name             String
  city             String    @default("") // 地名（市区町村など）… {地名}
  area             String    @default("") // エリア（駅名・地域）… {エリア}
  vars             Json      @default("{}") // 任意の差し込み項目 {項目名: 値}
  features         String    @default("") // 得意な施術・特徴
  bookingUrl       String    @default("")
  ctaType          String    @default("BOOK") // BOOK / CALL / LEARN_MORE / NONE
  photoUrls        String    @default("") // 投稿用写真の URL（1 行に 1 つ、順番に使う）
  gbpAccountId     String?
  gbpLocationId    String?   @unique
  gbpEnabled       Boolean   @default(true)
  igUserId         String?
  igAccessToken    String?   // 暗号化して保存
  igTokenExpiresAt DateTime?
  igHashtags       String    @default("") // 店舗独自のハッシュタグ（地域名など）
  igEnabled        Boolean   @default(false)
  isActive         Boolean   @default(true)
  sortOrder        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  posts       Post[]
  credentials StoreCredential[]

  @@index([isActive, sortOrder])
}

// 1 回分の投稿（全店舗共通のテーマ・日時）
model PostBatch {
  id          String   @id @default(cuid())
  theme       String
  memo        String   @default("")
  imageUrl    String?  // 全店舗共通の画像（未指定なら店舗の写真を使う）
  scheduledAt DateTime
  mode        String   @default("ai")    // ai（AI が店舗ごとに作成）/ template（テンプレートに店舗情報を差し込む）
  gbpTemplate String   @default("")
  igTemplate  String   @default("")
  mediaType   String   @default("image") // image / reel / none
  headline    String   @default("")      // 画像・動画に入れる見出し
  bgPrompt    String   @default("")      // AI 背景画像の指示
  bgImageUrl  String?                    // 全店舗共通の背景（AI 生成またはアップロード）
  createdAt   DateTime @default(now())

  posts Post[]

  @@index([scheduledAt])
}

// 店舗ごとの投稿内容
model Post {
  id         String    @id @default(cuid())
  batchId    String
  storeId    String
  gbpText    String    @default("")
  igCaption  String    @default("")
  imageUrl   String?
  videoUrl   String?   // Instagram リール用の動画
  // pending（AI 作成待ち）/ draft（確認待ち）/ approved / posted / failed / skipped
  status     String    @default("pending")
  flags      Json      @default("[]")
  error      String?
  approvedAt DateTime?
  approvedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  batch      PostBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  store      Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  deliveries Delivery[]

  @@unique([batchId, storeId])
  @@index([status])
}

// 媒体ごとの送信結果
model Delivery {
  id          String    @id @default(cuid())
  postId      String
  channel     String    // gbp / instagram
  status      String    @default("pending") // pending / sending / processing（リール処理待ち）/ sent / failed / skipped
  externalId  String?
  error       String?
  attempts    Int       @default(0)
  sentAt      DateTime?
  metrics     Json?     // Instagram の投稿別インサイト（分析時に更新）
  metricsAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, channel])
  @@index([status])
}

// 店舗の SNS 等のログイン情報（パスワードは暗号化して保存。表示するたびに記録を残す）
model StoreCredential {
  id          String   @id @default(cuid())
  storeId     String
  service     String   @default("instagram") // instagram / google / other
  loginId     String
  passwordEnc String   @default("")
  note        String   @default("")
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  logs  CredentialAccessLog[]

  @@unique([storeId, service])
}

model CredentialAccessLog {
  id           String   @id @default(cuid())
  credentialId String
  userEmail    String
  action       String   // reveal / update
  at           DateTime @default(now())

  credential StoreCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([at])
}

// パフォーマンス分析レポート
model AnalysisReport {
  id          String   @id @default(cuid())
  status      String   @default("running") // running / done / failed
  periodStart DateTime
  periodEnd   DateTime
  data        Json     @default("{}")
  summary     String   @default("")
  themeIdeas  String[] @default([])
  error       String?
  createdBy   String
  createdAt   DateTime @default(now())
}
