// ONE'S MEAL — ジム会員/一般ユーザー食事管理 + 管理サイト

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// エンドユーザー（LINE LIFF ログインで作成される）
model User {
  id            String    @id @default(cuid())
  lineUserId    String    @unique
  displayName   String
  pictureUrl    String?
  email         String?

  // ONE'S BODY 会員フラグ
  isMember      Boolean   @default(false)
  memberCode    String?   @unique
  memberSince   DateTime?

  // プロフィール
  sex           String?   // male / female
  age           Int?
  heightCm      Float?
  weightKg      Float?
  targetWeight  Float?
  activity      String?   // low / mid / high
  goal          String?   // diet / bodymake / bulk / log (←logは記録のみ)
  onboardedAt   DateTime?

  // 目標と計画
  goalStartedAt   DateTime?
  goalDeadline    DateTime?
  goalPlanSummary String?   // 表示用要旨
  goalPlanJson    String?   // 構造化プラン
  goalApproved    Boolean   @default(false)
  goalUseExercise Boolean   @default(false)  // 運動ありき目標か
  goalWeeklyFreq  Int?                       // 週運動回数（1〜7）

  // 個人代謝係数（学習結果）
  metabolicFactor   Float     @default(1.0)
  metabolicLastCalc DateTime?

  // 機能モジュール（選択制）
  featExercise  Boolean   @default(false)
  featSleep     Boolean   @default(false)
  featWater     Boolean   @default(false)
  featSteps     Boolean   @default(false)

  // メタ
  lastSeenAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  meals         Meal[]
  weights       Weight[]
  workouts      Workout[]
  steps         Steps[]
  sleeps        Sleep[]
  waters        Water[]
  comments      TrainerComment[]

  @@index([isMember])
  @@index([createdAt])
}

// トレーニングセッション
model Workout {
  id           String   @id @default(cuid())
  userId       String
  date         String   // YYYY-MM-DD
  type         String   // cardio / strength

  // 有酸素用
  cardioName   String?
  durationMin  Int?
  distanceKm   Float?

  // 共通
  kcal         Int?     // 消費カロリー（推定 or 手入力）
  memo         String?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sets         StrengthSet[]

  @@index([userId, date])
}

// 睡眠（起床日付ベース）
model Sleep {
  id        String   @id @default(cuid())
  userId    String
  date      String   // 起床日 YYYY-MM-DD
  bedtime   String?  // HH:MM
  wakeTime  String?  // HH:MM
  hours     Float    // 睡眠時間（時）
  quality   Int?     // 1〜5
  memo      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

// 水分（日付ベース）
model Water {
  id        String   @id @default(cuid())
  userId    String
  date      String
  ml        Int      // その日の合計摂取ml
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

// 歩数（手動入力、将来 HealthKit 連携予定）
model Steps {
  id        String   @id @default(cuid())
  userId    String
  date      String   // YYYY-MM-DD
  count     Int
  source    String   @default("manual") // manual / healthkit / googlefit
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

// 筋トレのセット
model StrengthSet {
  id         String   @id @default(cuid())
  workoutId  String
  bodyPart   String   // chest / back / legs / shoulders / arms / abs / other
  exercise   String
  setNumber  Int      @default(1)
  weight     Float?
  reps       Int?
  createdAt  DateTime @default(now())

  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@index([workoutId])
}

// 食事ログ
model Meal {
  id        String   @id @default(cuid())
  userId    String
  date      String   // YYYY-MM-DD
  meal      String   // breakfast / lunch / dinner / snack
  name      String
  qty       Float    @default(1)
  unit      String   @default("1人前")
  kcal      Int
  protein   Float    @default(0)
  fat       Float    @default(0)
  carbs     Float    @default(0)
  source    String   @default("manual") // manual / db / photo
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// 体重ログ
model Weight {
  id        String   @id @default(cuid())
  userId    String
  date      String
  weight    Float
  bodyFat   Float?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

// トレーナー（管理サイトユーザー）
model Trainer {
  id           String   @id @default(cuid())
  lineUserId   String   @unique
  displayName  String
  pictureUrl   String?
  role         String   @default("trainer") // trainer / admin / owner
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  comments     TrainerComment[]
}

// トレーナーから会員へのコメント
model TrainerComment {
  id         String   @id @default(cuid())
  userId     String
  trainerId  String
  date       String?  // 特定日付に対するコメント or null=全般
  content    String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainer    Trainer  @relation(fields: [trainerId], references: [id])

  @@index([userId, createdAt])
}

// 会員招待コード
model MemberCode {
  code       String   @id
  note       String?
  used       Boolean  @default(false)
  usedByUser String?
  usedAt     DateTime?
  createdAt  DateTime @default(now())
  createdBy  String?
}

// 管理サイトのセッション（簡易実装）
model TrainerSession {
  id         String   @id @default(cuid())
  trainerId  String
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([token])
}
