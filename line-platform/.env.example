# --- DB (PostgreSQL) ---
# Local example: postgresql://postgres:postgres@localhost:5432/line_platform
DATABASE_URL=

# --- Auth ---
# `openssl rand -base64 32` で生成
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3001

# 初期管理者（super_admin として作成される）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Webhook 署名検証スキップ（ローカルデバッグ専用、本番では必ず false / 未設定）
SKIP_LINE_SIGNATURE=false

# Cron 認証用（cron-job.org 等の外部 Cron 経由で /api/cron/dispatch を叩く際の認証）
CRON_SECRET=

# 注意:
# LINE_CHANNEL_ACCESS_TOKEN / LINE_CHANNEL_SECRET は不要になりました（マルチテナント対応のため）。
# 各 LINE アカウントのトークンは管理画面から登録します。
