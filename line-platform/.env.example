# --- LINE Messaging API ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- DB (PostgreSQL) ---
# Local example: postgresql://postgres:postgres@localhost:5432/line_platform
DATABASE_URL=

# --- Auth ---
# `openssl rand -base64 32` で生成
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3001

# 管理画面ログイン用（初期1ユーザー）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Webhook 署名検証スキップ（ローカルデバッグ専用、本番では必ず false / 未設定）
SKIP_LINE_SIGNATURE=false
