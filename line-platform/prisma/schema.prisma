// LINE 公式アカウント運用プラットフォーム（マルチテナント版）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 管理画面ログインユーザー
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("operator") // super_admin / operator
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships ChannelMembership[]
}

// LINE 公式アカウント（テナント単位）
model LineChannel {
  id                  String   @id @default(cuid())
  name                String   // 表示名（例: "本店LINE", "渋谷店LINE"）
  description         String?
  color               String   @default("#06C755") // 管理画面のアクセントカラー
  channelAccessToken  String   // LINE Messaging API のチャネルアクセストークン
  channelSecret       String   // LINE Messaging API のチャネルシークレット
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  memberships  ChannelMembership[]
  friends      Friend[]
  tags         Tag[]
  broadcasts   Broadcast[]
  scenarios    Scenario[]
  deliveryLogs DeliveryLog[]

  @@index([isActive])
}

// 管理ユーザー x LINE チャネル の権限
model ChannelMembership {
  id            String   @id @default(cuid())
  adminUserId   String
  lineChannelId String
  role          String   @default("operator") // owner / operator
  createdAt     DateTime @default(now())

  adminUser   AdminUser   @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  lineChannel LineChannel @relation(fields: [lineChannelId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, lineChannelId])
  @@index([lineChannelId])
}

// LINE 友だち（チャネル単位）
model Friend {
  id              String   @id @default(cuid())
  lineChannelId   String
  lineUserId      String
  displayName     String?
  pictureUrl      String?
  statusMessage   String?
  language        String?
  isFollowing     Boolean  @default(true)
  followedAt      DateTime @default(now())
  unfollowedAt    DateTime?
  lastMessageAt   DateTime?
  notes           String?
  customFields    Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lineChannel     LineChannel      @relation(fields: [lineChannelId], references: [id], onDelete: Cascade)
  tags            FriendTag[]
  inboundMessages InboundMessage[]
  scenarioRuns    ScenarioRun[]
  deliveryLogs    DeliveryLog[]

  @@unique([lineChannelId, lineUserId])
  @@index([lineChannelId, isFollowing])
  @@index([lineChannelId, followedAt])
}

// タグ（チャネル単位）
model Tag {
  id            String   @id @default(cuid())
  lineChannelId String
  name          String
  color         String   @default("#06C755")
  createdAt     DateTime @default(now())

  lineChannel LineChannel    @relation(fields: [lineChannelId], references: [id], onDelete: Cascade)
  friends     FriendTag[]
  broadcasts  BroadcastTag[]

  @@unique([lineChannelId, name])
  @@index([lineChannelId])
}

// 友だち x タグ
model FriendTag {
  friendId String
  tagId    String
  addedAt  DateTime @default(now())

  friend Friend @relation(fields: [friendId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([friendId, tagId])
  @@index([tagId])
}

// 受信メッセージ履歴
model InboundMessage {
  id            String   @id @default(cuid())
  friendId      String
  lineMessageId String?
  type          String
  text          String?
  raw           Json
  receivedAt    DateTime @default(now())

  friend Friend @relation(fields: [friendId], references: [id], onDelete: Cascade)

  @@index([friendId, receivedAt])
}

// 一斉配信
model Broadcast {
  id                 String   @id @default(cuid())
  lineChannelId      String
  title              String
  messages           Json
  status             String   @default("draft")
  scheduledAt        DateTime?
  sentAt             DateTime?
  targetAllFollowers Boolean  @default(true)
  totalTargets       Int      @default(0)
  successCount       Int      @default(0)
  failureCount       Int      @default(0)
  errorMessage       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  lineChannel  LineChannel    @relation(fields: [lineChannelId], references: [id], onDelete: Cascade)
  tags         BroadcastTag[]
  deliveryLogs DeliveryLog[]

  @@index([lineChannelId, status, scheduledAt])
  @@index([status, scheduledAt])
}

// 配信先タグ
model BroadcastTag {
  broadcastId String
  tagId       String

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([broadcastId, tagId])
}

// ステップ配信シナリオ
model Scenario {
  id            String   @id @default(cuid())
  lineChannelId String
  name          String
  description   String?
  triggerType   String   @default("follow")
  triggerTagId  String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lineChannel LineChannel    @relation(fields: [lineChannelId], references: [id], onDelete: Cascade)
  steps       ScenarioStep[]
  runs        ScenarioRun[]

  @@index([lineChannelId])
}

model ScenarioStep {
  id           String   @id @default(cuid())
  scenarioId   String
  order        Int
  delayMinutes Int      @default(0)
  messages     Json
  createdAt    DateTime @default(now())

  scenario      Scenario          @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  scheduledRuns ScenarioRunStep[]

  @@unique([scenarioId, order])
}

model ScenarioRun {
  id         String    @id @default(cuid())
  scenarioId String
  friendId   String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    @default("running")

  scenario Scenario          @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  friend   Friend            @relation(fields: [friendId], references: [id], onDelete: Cascade)
  steps    ScenarioRunStep[]

  @@unique([scenarioId, friendId])
  @@index([status])
}

model ScenarioRunStep {
  id           String    @id @default(cuid())
  runId        String
  stepId       String
  scheduledAt  DateTime
  sentAt       DateTime?
  status       String    @default("pending")
  errorMessage String?

  run  ScenarioRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  step ScenarioStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
}

// 配信ログ
model DeliveryLog {
  id            String   @id @default(cuid())
  lineChannelId String?
  friendId      String?
  broadcastId   String?
  channel       String
  status        String
  errorMessage  String?
  sentAt        DateTime @default(now())

  lineChannel LineChannel? @relation(fields: [lineChannelId], references: [id], onDelete: SetNull)
  friend      Friend?      @relation(fields: [friendId], references: [id], onDelete: SetNull)
  broadcast   Broadcast?   @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  @@index([lineChannelId, sentAt])
  @@index([sentAt])
}
