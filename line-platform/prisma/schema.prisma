// LINE 公式アカウント運用プラットフォーム（マルチテナント版）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 管理画面ログインユーザー
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("operator") // super_admin / operator
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships ChannelMembership[]
}

// LINE 公式アカウント（テナント単位）
model LineChannel {
  id                  String   @id @default(cuid())
  name                String   // 表示名（例: "本店LINE", "渋谷店LINE"）
  description         String?
  color               String   @default("#06C755") // 管理画面のアクセントカラー
  channelAccessToken  String   // LINE Messaging API のチャネルアクセストークン
  channelSecret       String   // LINE Messaging API のチャネルシークレット
  lineBasicId         String?  // 公式アカウントの基本ID（@xxxx）oaMessage 用
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  memberships  ChannelMembership[]
  friends      Friend[]
  tags         Tag[]
  broadcasts   Broadcast[]
  scenarios    Scenario[]
  deliveryLogs DeliveryLog[]
  // 予約機能
  reservationSettings ReservationSettings?
  services            Service[]
  businessHours       BusinessHours[]
  holidays            Holiday[]
  referralSources     ReferralSource[]
  reservations        Reservation[]
  inquiries           Inquiry[]
  richMenu            RichMenu?

  @@index([isActive])
}

// 管理ユーザー x LINE チャネル の権限
model ChannelMembership {
  id            String   @id @default(cuid())
  adminUserId   String
  lineChannelId String
  role          String   @default("operator") // owner / operator
  createdAt     DateTime @default(now())

  adminUser   AdminUser   @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  lineChannel LineChannel @relation(fields: [lineChannelId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, lineChannelId])
  @@index([lineChannelId])
}

// === 予約機能 ===

// 予約システムの設定（チャネル毎に 1 件）
model ReservationSettings {
  id                     String   @id @default(cuid())
  lineChannelId          String   @unique
  isEnabled              Boolean  @default(false)
  // Google Sheets 連携
  spreadsheetId          String?
  sheetTabReservations   String   @default("予約")
  sheetTabSettings       String   @default("設定")
  sheetTabMenu           String   @default("メニュー")
  sheetTabHours          String   @default("営業時間")
  sheetTabReferral       String   @default("きっかけ")
  sheetTabInquiry        String   @default("問い合わせ一覧")
  // シート連動モード（当日タブから空き状況を読み、予約は問い合わせ一覧へリクエストとして追記）
  sheetLinkedMode          Boolean @default(false)
  newPatientDurationMinutes Int    @default(30)
  returningDurationMinutes  Int    @default(15)
  lowStockThreshold         Int    @default(1)
  inquiryReplyMessage       String?
  // 予約ルール
  slotMinutes            Int      @default(20)
  defaultBedCount        Int      @default(1)
  bookingHorizonDays     Int      @default(30)
  bookingLeadHours       Int      @default(2)
  // LIFF
  liffId                 String?
  // 店舗表示
  clinicName             String?
  clinicAddress          String?
  clinicPhone            String?
  clinicPhotoUrl         String?  // 店舗写真（data URL or 外部URL）
  themeColor             String   @default("#1ABC9C")
  // 予約完了時の挙動
  sendConfirmMessage     Boolean  @default(false)
  confirmMessageTemplate String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  lineChannel LineChannel @relation(fields: [lineChannelId], references: [id], onDelete: Cascade)
}

// メニュー（固定リスト）
model Service {
  id              String   @id @default(cuid())
  lineChannelId   String
  name            String
  durationMinutes Int      // 20 の倍数を想定
  price           Int      @default(0) // 円
  description     String?
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lineChannel  LineChannel   @relation(fields: [lineChannelId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@index([lineChannelId, isActive, sortOrder])
}

// 営業時間（曜日ベース）
model BusinessHours {
  id            String  @id @default(cuid())
  lineChannelId String
  dayOfWeek     Int     // 0=日, 1=月, ..., 6=土
  isClosed      Boolean @default(false)
  openTime      String? // "HH:MM"
  closeTime     String? // "HH:MM"

  lineChannel LineChannel @relation(fields: [lineChannelId], references: [id], onDelete: Cascade)

  @@unique([lineChannelId, dayOfWeek])
}

// 臨時休業日
model Holiday {
  id            String   @id @default(cuid())
  lineChannelId String
  date          DateTime // 日付（時刻は無視）
  reason        String?

  lineChannel LineChannel @relation(fields: [lineChannelId], references: [id], onDelete: Cascade)

  @@unique([lineChannelId, date])
  @@index([lineChannelId, date])
}

// 知ったきっかけ（プルダウン項目）
model ReferralSource {
  id            String   @id @default(cuid())
  lineChannelId String
  name          String
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  lineChannel LineChannel @relation(fields: [lineChannelId], references: [id], onDelete: Cascade)

  @@unique([lineChannelId, name])
  @@index([lineChannelId, isActive, sortOrder])
}

// 予約
model Reservation {
  id              String    @id @default(cuid())
  lineChannelId   String
  serviceId       String?
  // サービス情報スナップショット（後でメニュー変更されても予約は当時の値）
  serviceName     String
  durationMinutes Int
  price           Int       @default(0)
  // 予約時間
  startAt         DateTime
  endAt           DateTime
  // 顧客情報
  customerName    String
  customerPhone   String
  referralSource  String?
  // LINE 連携（LIFF 経由のとき設定）
  lineUserId      String?
  friendId        String?
  // ステータス
  status          String    @default("confirmed") // confirmed / cancelled / no_show
  cancelledAt     DateTime?
  cancelReason    String?
  notes           String?
  // Sheet 連携
  sheetRowNumber  Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  lineChannel LineChannel @relation(fields: [lineChannelId], references: [id], onDelete: Cascade)
  service     Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  friend      Friend?     @relation(fields: [friendId], references: [id], onDelete: SetNull)

  @@index([lineChannelId, startAt])
  @@index([lineChannelId, status, startAt])
  @@index([lineUserId])
}

// === 予約機能 ここまで ===

// シート連動モードの予約リクエスト（DB 控え）
model Inquiry {
  id             String   @id @default(cuid())
  lineChannelId  String
  date           String   // 第1希望日 YYYY-MM-DD
  time           String   // 第1希望時間 H:MM
  preferences    Json?    // [{date, time}, ...] 第1〜第3希望
  visitType      String   // new / returning
  customerName   String
  customerPhone  String
  referralSource String?
  lineUserId     String?
  status         String   @default("pending") // pending / handled / cancelled
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lineChannel LineChannel @relation(fields: [lineChannelId], references: [id], onDelete: Cascade)

  @@index([lineChannelId, createdAt])
  @@index([lineChannelId, status])
}

// リッチメニュー
model RichMenu {
  id             String   @id @default(cuid())
  lineChannelId  String   @unique
  size           String   @default("large") // large(2500x1686) / compact(2500x843)
  layout         String   @default("2") // ボタン数: 1/2/3/4/6
  chatBarText    String   @default("メニュー")
  buttons        Json     // [{label, actionType, value, bgColor, textColor}]
  lineRichMenuId String?  // LINE 側の richMenuId
  isApplied      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lineChannel LineChannel @relation(fields: [lineChannelId], references: [id], onDelete: Cascade)
}

// LINE 友だち（チャネル単位）
model Friend {
  id              String   @id @default(cuid())
  lineChannelId   String
  lineUserId      String
  displayName     String?
  pictureUrl      String?
  statusMessage   String?
  language        String?
  isFollowing     Boolean  @default(true)
  followedAt      DateTime @default(now())
  unfollowedAt    DateTime?
  lastMessageAt   DateTime?
  notes           String?
  customFields    Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lineChannel     LineChannel      @relation(fields: [lineChannelId], references: [id], onDelete: Cascade)
  tags            FriendTag[]
  inboundMessages InboundMessage[]
  scenarioRuns    ScenarioRun[]
  deliveryLogs    DeliveryLog[]
  reservations    Reservation[]

  @@unique([lineChannelId, lineUserId])
  @@index([lineChannelId, isFollowing])
  @@index([lineChannelId, followedAt])
}

// タグ（チャネル単位）
model Tag {
  id            String   @id @default(cuid())
  lineChannelId String
  name          String
  color         String   @default("#06C755")
  createdAt     DateTime @default(now())

  lineChannel LineChannel    @relation(fields: [lineChannelId], references: [id], onDelete: Cascade)
  friends     FriendTag[]
  broadcasts  BroadcastTag[]

  @@unique([lineChannelId, name])
  @@index([lineChannelId])
}

// 友だち x タグ
model FriendTag {
  friendId String
  tagId    String
  addedAt  DateTime @default(now())

  friend Friend @relation(fields: [friendId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([friendId, tagId])
  @@index([tagId])
}

// 受信メッセージ履歴
model InboundMessage {
  id            String   @id @default(cuid())
  friendId      String
  lineMessageId String?
  type          String
  text          String?
  raw           Json
  receivedAt    DateTime @default(now())

  friend Friend @relation(fields: [friendId], references: [id], onDelete: Cascade)

  @@index([friendId, receivedAt])
}

// 一斉配信
model Broadcast {
  id                 String   @id @default(cuid())
  lineChannelId      String
  title              String
  messages           Json
  status             String   @default("draft")
  scheduledAt        DateTime?
  sentAt             DateTime?
  targetAllFollowers Boolean  @default(true)
  totalTargets       Int      @default(0)
  successCount       Int      @default(0)
  failureCount       Int      @default(0)
  errorMessage       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  lineChannel  LineChannel    @relation(fields: [lineChannelId], references: [id], onDelete: Cascade)
  tags         BroadcastTag[]
  deliveryLogs DeliveryLog[]

  @@index([lineChannelId, status, scheduledAt])
  @@index([status, scheduledAt])
}

// 配信先タグ
model BroadcastTag {
  broadcastId String
  tagId       String

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([broadcastId, tagId])
}

// ステップ配信シナリオ
model Scenario {
  id            String   @id @default(cuid())
  lineChannelId String
  name          String
  description   String?
  triggerType   String   @default("follow")
  triggerTagId  String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lineChannel LineChannel    @relation(fields: [lineChannelId], references: [id], onDelete: Cascade)
  steps       ScenarioStep[]
  runs        ScenarioRun[]

  @@index([lineChannelId])
}

model ScenarioStep {
  id           String   @id @default(cuid())
  scenarioId   String
  order        Int
  delayMinutes Int      @default(0)
  messages     Json
  createdAt    DateTime @default(now())

  scenario      Scenario          @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  scheduledRuns ScenarioRunStep[]

  @@unique([scenarioId, order])
}

model ScenarioRun {
  id         String    @id @default(cuid())
  scenarioId String
  friendId   String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    @default("running")

  scenario Scenario          @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  friend   Friend            @relation(fields: [friendId], references: [id], onDelete: Cascade)
  steps    ScenarioRunStep[]

  @@unique([scenarioId, friendId])
  @@index([status])
}

model ScenarioRunStep {
  id           String    @id @default(cuid())
  runId        String
  stepId       String
  scheduledAt  DateTime
  sentAt       DateTime?
  status       String    @default("pending")
  errorMessage String?

  run  ScenarioRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  step ScenarioStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
}

// 配信ログ
model DeliveryLog {
  id            String   @id @default(cuid())
  lineChannelId String?
  friendId      String?
  broadcastId   String?
  channel       String
  status        String
  errorMessage  String?
  sentAt        DateTime @default(now())

  lineChannel LineChannel? @relation(fields: [lineChannelId], references: [id], onDelete: SetNull)
  friend      Friend?      @relation(fields: [friendId], references: [id], onDelete: SetNull)
  broadcast   Broadcast?   @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  @@index([lineChannelId, sentAt])
  @@index([sentAt])
}
